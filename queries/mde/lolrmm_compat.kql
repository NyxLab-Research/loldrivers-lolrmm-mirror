"000001:manifest","manifest","000001","","","","","","","41","777b4b850bbefe48c89c96892901d884e73c0371257c4701db214da6e110bd08"
]);
let ProfileMarker=materialize(ProfileRaw | where record_type == "manifest" | top 1 by release desc);
let ProfileRelease=toscalar(ProfileMarker | project release);
let ProfileRows=materialize(ProfileRaw | where record_type == "profile" and release == ProfileRelease);
let ProfileOK=toscalar(ProfileRows | summarize n=count()) == toscalar(ProfileMarker | project tolong(expected_rows))
    and toscalar(ProfileRows | summarize by process_name | count) == toscalar(ProfileRows | count)
    and toscalar(ProfileRows | summarize by release_digest | count) == 1
    and toscalar(ProfileRows | take 1 | project release_digest) == toscalar(ProfileMarker | project release_digest)
    and toscalar(ProfileRows | summarize n=count()) > 0;
let Profiles=materialize(ProfileRows | where ProfileOK | project ProfileName=process_name, ProfileTool=tool_name, ProfileId=tool_id,
    ProfileSigners=signers, ProfileRole=software_role, ProfileIocNames=ioc_names);
let Network = materialize(
    DeviceNetworkEvents
    | where Timestamp between (ReportStart .. ReportEnd)
    | where ActionType == "ConnectionSuccess"
    | extend _RemoteTarget=coalesce(RemoteUrl, RemoteIP)
    | where isnotempty(_RemoteTarget)
    | where SourceUnsafe or MissingTerms or array_length(PrefilterTerms) > 480
        or _RemoteTarget has_any (array_slice(PrefilterTerms, 0, 119))
        or _RemoteTarget has_any (array_slice(PrefilterTerms, 120, 239))
        or _RemoteTarget has_any (array_slice(PrefilterTerms, 240, 359))
        or _RemoteTarget has_any (array_slice(PrefilterTerms, 360, 479))
    | where SourceUnsafe or _RemoteTarget matches regex TargetPattern
    | extend RemoteHost=tolower(trim_end(@"[.]+", tostring(parse_url(iff(_RemoteTarget startswith "//", strcat("https:", _RemoteTarget), iff(_RemoteTarget contains "://", _RemoteTarget, strcat("https://", _RemoteTarget)))).Host)))
    | where isnotempty(RemoteHost)
    | project Timestamp, DeviceId, DeviceName, RemoteUrl, RemoteHost, RemoteIP,
              RemotePort, LocalIP, InitiatingProcessFileName, InitiatingProcessFolderPath,
              InitiatingProcessSHA1, InitiatingProcessSHA256, InitiatingProcessCommandLine,
              InitiatingProcessAccountName, InitiatingProcessAccountDomain,
              InitiatingProcessParentFileName, InitiatingProcessParentId,
              InitiatingProcessId, InitiatingProcessVersionInfoCompanyName,
              InitiatingProcessVersionInfoProductName, InitiatingProcessVersionInfoOriginalFileName, InitiatingProcessUniqueId, InitiatingProcessCreationTime
);
let CandidateHashes = Network
    | where InitiatingProcessSHA1 matches regex @"^[a-fA-F0-9]{40}$"
    | distinct SHA1=tolower(InitiatingProcessSHA1);
let CertificateObservations = materialize(CandidateHashes
    | join kind=inner hint.strategy=broadcast (
        DeviceFileCertificateInfo
        | where Timestamp between (CertificateStart .. ReportEnd)
        | project Timestamp, DeviceId, SHA1=tolower(SHA1), IsSigned, IsTrusted, Signer
    ) on SHA1
    | project Timestamp, DeviceId, SHA1, IsSigned, IsTrusted, Signer);
let Certificates = CertificateObservations
    | summarize arg_max(Timestamp, IsSigned, IsTrusted, Signer) by DeviceId, SHA1
    | project DeviceId, RuleSHA1=SHA1, CertificateObservedAt=Timestamp, IsSigned, IsTrusted, Signer;
let HashEvidence = CertificateObservations
    | summarize HashBad=countif(IsSigned == false or IsTrusted == false),
                HashUnknown=countif(isnull(IsSigned) or isnull(IsTrusted) or isempty(trim(@"\s+", Signer))),
                HashPublishers=make_set(tolower(Signer)), arg_max(Timestamp, Signer, DeviceId) by SHA1
    | extend HashEvidenceValid=HashBad == 0 and HashUnknown == 0 and array_length(HashPublishers) == 1,
             HashEvidenceConflict=HashBad > 0 or array_length(HashPublishers) > 1
    | project RuleSHA1=SHA1, HashEvidenceValid, HashEvidenceConflict,
              HashEvidenceSigner=Signer, HashEvidenceDeviceId=DeviceId, HashEvidenceTime=Timestamp;
let Activities = Network
    | extend RuleSHA1=tolower(InitiatingProcessSHA1)
    | join kind=leftouter Certificates on DeviceId, RuleSHA1
    | join kind=leftouter HashEvidence on RuleSHA1
    | extend RuleName=tolower(coalesce(InitiatingProcessFileName, "")),
             RulePath=iff(InitiatingProcessFolderPath matches regex @"^[A-Za-z]:[\\/]", tolower(replace_string(InitiatingProcessFolderPath, "/", "\\")), InitiatingProcessFolderPath),
             RuleSigner=tolower(Signer), RuleDeviceName=tolower(DeviceName),
             RuleSHA256=tolower(InitiatingProcessSHA256),
             SignatureValid=iff(isnull(IsSigned) or isnull(IsTrusted), bool(null), IsSigned and IsTrusted)
    | extend UseHashEvidence=true and isnull(CertificateObservedAt) and HashEvidenceValid == true
    | extend RuleEvidenceSigner=iff(UseHashEvidence, tolower(HashEvidenceSigner), RuleSigner),
             RuleEvidenceValid=iff(UseHashEvidence, true, SignatureValid),
             SignatureEvidenceSource=case(isnotnull(CertificateObservedAt), "device_sha1", UseHashEvidence, "tenant_sha1", "missing"),
             SignatureEvidenceDeviceId=iff(UseHashEvidence, HashEvidenceDeviceId, iff(isnotnull(CertificateObservedAt), DeviceId, "")),
             SignatureEvidenceTime=iff(UseHashEvidence, HashEvidenceTime, CertificateObservedAt)
| extend RuleOriginal=tolower(InitiatingProcessVersionInfoOriginalFileName)
| join kind=leftouter Profiles on $left.RuleName == $right.ProfileName
| join kind=leftouter (Profiles | project OriginalName=ProfileName, OriginalTool=ProfileTool, OriginalId=ProfileId,
    OriginalSigners=ProfileSigners, OriginalRole=ProfileRole, OriginalIocNames=ProfileIocNames) on $left.RuleOriginal == $right.OriginalName
| extend DetectedTool=coalesce(ProfileTool, OriginalTool), DetectedToolId=coalesce(ProfileId, OriginalId),
    SoftwareRole=coalesce(ProfileRole, OriginalRole), ExpectedSigners=coalesce(ProfileSigners, OriginalSigners),
    IdentityIocNames=coalesce(ProfileIocNames, OriginalIocNames),
    IdentityConflict=isnotempty(ProfileId) and isnotempty(OriginalId) and ProfileId != OriginalId,
    IdentityBasis=case(isnotempty(ProfileName), "file_name", isnotempty(OriginalName), "original_filename", "")
| extend EvidenceLevel=case(IdentityConflict, "evidence_conflict", isempty(DetectedToolId), "domain_only",
    RuleEvidenceValid == true and isnotempty(RuleEvidenceSigner) and ExpectedSigners contains_cs strcat(";", RuleEvidenceSigner, ";")
    and SoftwareRole != "dual_use", "supported_identity", "software_candidate")
| extend ProfileVersion=ProfileRelease, ReportStatus=iff(ProfileOK, "ok", "profile_data_unavailable")
| extend DefaultRuleIds = strcat(iff(((((isnotempty(RuleName) and (RuleName == "chrome.exe")))
                and ((isnotempty(RulePath) and (RulePath matches regex "^[a-z]:\\\\(?:program files(?: \\(x86\\))?|users\\\\[^\\\\]+\\\\appdata\\\\(?:local|roaming))\\\\(?:[^\\\\]+\\\\)*google\\\\(?:[^\\\\]+\\\\)*chrome[.]exe$")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "google (?:llc|inc)"))))
            or (((isnotempty(RuleName) and (RuleName == "msedge.exe")))
                and ((isnotempty(RulePath) and (RulePath matches regex "^[a-z]:\\\\(?:program files(?: \\(x86\\))?|users\\\\[^\\\\]+\\\\appdata\\\\(?:local|roaming))\\\\(?:[^\\\\]+\\\\)*microsoft\\\\edge\\\\(?:[^\\\\]+\\\\)*msedge[.]exe$")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "microsoft corporation"))))
            or (((isnotempty(RuleName) and (RuleName == "firefox.exe")))
                and ((isnotempty(RulePath) and (RulePath matches regex "^[a-z]:\\\\(?:program files(?: \\(x86\\))?|users\\\\[^\\\\]+\\\\appdata\\\\(?:local|roaming))\\\\(?:[^\\\\]+\\\\)*mozilla firefox\\\\(?:[^\\\\]+\\\\)*firefox[.]exe$")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "mozilla corporation"))))
            or (((isnotempty(RuleName) and (RuleName == "vivaldi.exe")))
                and ((isnotempty(RulePath) and (RulePath matches regex "^[a-z]:\\\\(?:program files(?: \\(x86\\))?|users\\\\[^\\\\]+\\\\appdata\\\\(?:local|roaming))\\\\(?:[^\\\\]+\\\\)*vivaldi\\\\(?:[^\\\\]+\\\\)*vivaldi[.]exe$")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "vivaldi technologies"))))
            or (((isnotempty(RuleName) and (RuleName == "qqbrowser.exe")))
                and ((isnotempty(RulePath) and (RulePath matches regex "^[a-z]:\\\\(?:program files(?: \\(x86\\))?|users\\\\[^\\\\]+\\\\appdata\\\\(?:local|roaming))\\\\(?:[^\\\\]+\\\\)*tencent\\\\qqbrowser\\\\(?:[^\\\\]+\\\\)*qqbrowser[.]exe$")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "tencent technology"))))
            or ((isnotempty(RuleName) and (RuleName in ("sogouexplorer.exe")))
                and ((isnotempty(RulePath) and (RulePath matches regex "^[a-z]:\\\\program files(?: \\(x86\\))?\\\\sogou\\\\sogouexplorer\\\\(?:[^\\\\]+\\\\)*sogouexplorer[.]exe$")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "^(?:beijing sogou technology development co[.]?,? ltd[.]?|tencent technology ?\\(shenzhen\\) company limited)$"))))
            or ((isnotempty(RuleName) and (RuleName in ("google chrome", "google chrome helper", "google chrome helper (renderer)", "google chrome helper (gpu)", "google chrome helper (plugin)")))
                and ((isnotempty(RulePath) and (RulePath matches regex "(?i)^/(?:applications|users/[^/]+/applications)/google chrome[.]app/contents/(?:macos/google chrome|frameworks/google chrome framework[.]framework/versions/[^/]+/helpers/google chrome helper(?: \\((?:renderer|gpu|plugin)\\))?[.]app/contents/macos/google chrome helper(?: \\((?:renderer|gpu|plugin)\\))?)$")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "^(?:developer id application: )?google (?:llc|inc)(?: \\([a-z0-9]+\\))?$"))))
            or ((isnotempty(RuleName) and (RuleName in ("microsoft edge", "microsoft edge helper", "microsoft edge helper (renderer)", "microsoft edge helper (gpu)", "microsoft edge helper (plugin)")))
                and ((isnotempty(RulePath) and (RulePath matches regex "(?i)^/(?:applications|users/[^/]+/applications)/microsoft edge[.]app/contents/(?:macos/microsoft edge|frameworks/microsoft edge framework[.]framework/versions/[^/]+/helpers/microsoft edge helper(?: \\((?:renderer|gpu|plugin)\\))?[.]app/contents/macos/microsoft edge helper(?: \\((?:renderer|gpu|plugin)\\))?)$")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "^(?:developer id application: )?microsoft corporation(?: \\([a-z0-9]+\\))?$"))))), "rpt-browser-standard;", ""),
         iff((((isnotempty(RuleName) and (RuleName in ("ima.copilot.exe")))
                and ((isnotempty(RulePath) and (RulePath matches regex "^[a-z]:\\\\(?:program files(?: \\(x86\\))?\\\\ima[.]copilot|ima[.]copilot|users\\\\[^\\\\]+\\\\appdata\\\\local\\\\ima[.]copilot\\\\application)\\\\ima[.]copilot[.]exe$")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "^tencent technology ?\\(shenzhen\\) company limited$")))
                and ((isnotempty(RemoteHost) and (RemoteHost == "oth.eve.mdt.qq.com"))))), "rpt-ima-mdt;", ""),
         iff(((((isnotempty(RulePath) and (RulePath matches regex "^[a-z]:\\\\program files(?: \\(x86\\))?\\\\(?:manageengine\\\\uems_agent|desktopcentral_agent)\\\\")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "zoho corporation"))))
            or (((isnotempty(RulePath) and (RulePath matches regex "^/Library/(?:ManageEngine/UEMS_Agent|Desktopcentral_Agent)/")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "developer id application: zoho corporation"))))), "rpt-manageengine-endpointcentral;", ""),
         iff((((isnotempty(RuleName) and (RuleName in ("outlook.exe")))
                and ((isnotempty(RulePath) and (RulePath matches regex "^[a-z]:\\\\program files(?: \\(x86\\))?\\\\microsoft office\\\\(?:root\\\\)?office[0-9]+\\\\outlook[.]exe$")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "^microsoft corporation$")))
                and ((isnotempty(RemoteHost) and (RemoteHost == "oth.eve.mdt.qq.com"))))), "rpt-outlook-mdt;", ""),
         iff((((isnotempty(RuleName) and (RuleName in ("biz_helper.exe", "sgbizlauncher.exe", "pinyinup.exe", "sgtool.exe", "sgsmartassistant.exe", "sogouexe.exe", "sogoucloud.exe", "sogousmartassistant.exe", "biz_aurfx.exe", "sgmyinput.exe", "sgwangzai.exe", "usernetschedule.exe", "crashrpt.exe", "biz_tool.exe", "sgpicfacetool.exe", "wubiup.exe", "imeutil.exe", "wbcrashrpt.exe", "isgpet.exe", "sgiguidehelper.exe", "wbusernetschedule.exe", "write_spirit.exe", "sgwizard.exe", "sogou_voice_assistant.exe", "sgfeedbackhelper.exe")))
                and ((isnotempty(RulePath) and (RulePath matches regex "^[a-z]:\\\\(?:[^\\\\]+\\\\)*(?:sogouinput|sogouwbinput)\\\\")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "(?:beijing sogou|tencent technology)")))
                and ((isnotempty(RemoteHost) and (RemoteHost == "oth.eve.mdt.qq.com"))))), "rpt-sogou-input-mdt;", ""),
         iff((((isnotempty(RuleName) and (RuleName in ("yuanbao.exe")))
                and ((isnotempty(RulePath) and (RulePath matches regex "^[a-z]:\\\\(?:program files(?: \\(x86\\))?\\\\tencent\\\\yuanbao|users\\\\[^\\\\]+\\\\(?:appdata\\\\(?:local|roaming)\\\\(?:tencent\\\\)?)?yuanbao)\\\\yuanbao[.]exe$")))
                and ((isnotnull(RuleEvidenceValid) and (RuleEvidenceValid == true)))
                and ((isnotempty(RuleEvidenceSigner) and (RuleEvidenceSigner matches regex "^tencent technology ?\\(shenzhen\\) company limited$")))
                and ((isnotempty(RemoteHost) and (RemoteHost == "oth.eve.mdt.qq.com"))))), "rpt-yuanbao-mdt;", "")),
         RetainRuleIds = "",
         CustomerActivityRuleIds = ""
| extend ActivityDecision = iff((DefaultRuleIds != "" and RetainRuleIds == "") or CustomerActivityRuleIds != "", "excluded", "retained")
| extend NoiseConflict = iff(DetectedToolId != "" and DefaultRuleIds != "" and not(DefaultRuleIds contains "rpt-manageengine-endpointcentral"), true, false)
| extend ActivityDecision=iff(CustomerActivityRuleIds != "", "excluded", iff(NoiseConflict, "retained", ActivityDecision)),
    EvidenceLevel=iff(NoiseConflict or IdentityConflict, "evidence_conflict", EvidenceLevel)
| extend DispositionReason=iff(CustomerActivityRuleIds != "", "customer_whitelist", iff(NoiseConflict, "identity_noise_conflict",
    iff(ActivityDecision == "excluded" and DefaultRuleIds contains "rpt-manageengine-endpointcentral", "report_scope_exclusion",
    iff(ActivityDecision == "excluded" and DefaultRuleIds contains "rpt-browser-standard", "browser_report_scope",
    iff(ActivityDecision == "excluded", "known_noise", "retained")))))
| extend ReviewCategory = iff(RuleName == "", "process_identity_missing", iff(RuleName == "wwmpapp.exe" and ((isnotempty(RulePath) and (RulePath matches regex "^[a-z]:.*\\\\wemeet\\\\wwmpapp[.]exe$"))), "meeting_component_candidate", iff(RemoteHost == "oth.eve.mdt.qq.com", "shared_domain_activity", "rmm_domain_activity")))
| where ActivityDecision == "retained"
    | summarize FirstSeen=min(Timestamp), LastSeen=max(Timestamp), EventCount=count(),
                DeviceNames=make_set(DeviceName), RemoteURLs=make_set(RemoteUrl),
                RemoteIPs=make_set(RemoteIP), RemotePorts=make_set(RemotePort), LocalIPs=make_set(LocalIP),
                AccountNames=make_set(InitiatingProcessAccountName), AccountDomains=make_set(InitiatingProcessAccountDomain),
                OriginalFileNames=make_set(InitiatingProcessVersionInfoOriginalFileName), ProcessUniqueIds=make_set(InitiatingProcessUniqueId), ProcessCreationTimes=make_set(InitiatingProcessCreationTime),
                CompanyNames=make_set(InitiatingProcessVersionInfoCompanyName), ProductNames=make_set(InitiatingProcessVersionInfoProductName),
                CommandLines=make_set(InitiatingProcessCommandLine), ParentNames=make_set(InitiatingProcessParentFileName),
                ParentIds=make_set(InitiatingProcessParentId), ProcessIds=make_set(InitiatingProcessId),
                Signers=make_set(Signer), SignedStates=make_set(IsSigned), TrustedStates=make_set(IsTrusted),
                CertificateTimes=make_set(CertificateObservedAt),
                ExclusionSigners=make_set(RuleEvidenceSigner), ExclusionSignatureStates=make_set(RuleEvidenceValid),
                SignatureEvidenceSources=make_set(SignatureEvidenceSource), SignatureEvidenceDeviceIds=make_set(SignatureEvidenceDeviceId),
                SignatureEvidenceTimes=make_set(SignatureEvidenceTime), HashEvidenceConflicts=make_set(HashEvidenceConflict)
      by DeviceId, RemoteHost, InitiatingProcessFileName, InitiatingProcessFolderPath,
         InitiatingProcessSHA1, InitiatingProcessSHA256, DetectedTool, DetectedToolId, SoftwareRole, IdentityBasis, IdentityIocNames, EvidenceLevel, ProfileVersion, ReportStatus, DispositionReason, ReviewCategory, ActivityDecision, DefaultRuleIds, RetainRuleIds, CustomerActivityRuleIds
    | extend Labels=split(RemoteHost, ".")
    | mv-expand LabelIndex=range(0, array_length(Labels)-1, 1) to typeof(long)
    | extend Domain=strcat_array(array_slice(Labels, LabelIndex, -1), ".")
    | project-away Labels, LabelIndex;
RMMRows
| join kind=inner hint.strategy=broadcast Activities on Domain
| extend _PatternParts=split(Pattern, "*")
| where (array_length(_PatternParts) == 1 and RemoteHost == Pattern)
     or (array_length(_PatternParts) == 2
         and RemoteHost startswith_cs tostring(_PatternParts[0])
         and RemoteHost endswith_cs tostring(_PatternParts[1])
         and strlen(RemoteHost) >= strlen(tostring(_PatternParts[0])) + strlen(tostring(_PatternParts[1])))
| extend CustomerAssociationRuleIds = ""
| extend AssociationDecision = iff(CustomerAssociationRuleIds != "", "excluded", "retained")
| where AssociationDecision == "retained"
| summarize MatchedDomains=make_set(Domain), RMMTools=make_set(RMMTool), SourcePatterns=make_set(Pattern),
            CustomerAssociationRuleIds=make_set(CustomerAssociationRuleIds),
            take_any(FirstSeen, LastSeen, EventCount, DeviceNames, RemoteURLs, RemoteIPs, RemotePorts, LocalIPs,
                     OriginalFileNames, ProcessUniqueIds, ProcessCreationTimes, AccountNames, AccountDomains, CompanyNames, ProductNames, CommandLines, ParentNames,
                     ParentIds, ProcessIds, Signers, SignedStates, TrustedStates, CertificateTimes,
                     ExclusionSigners, ExclusionSignatureStates, SignatureEvidenceSources, SignatureEvidenceDeviceIds,
                     SignatureEvidenceTimes, HashEvidenceConflicts)
  by DeviceId, RemoteHost, InitiatingProcessFileName, InitiatingProcessFolderPath,
     InitiatingProcessSHA1, InitiatingProcessSHA256, DetectedTool, DetectedToolId, SoftwareRole, IdentityBasis, IdentityIocNames, EvidenceLevel, ProfileVersion, ReportStatus, DispositionReason, ReviewCategory, ActivityDecision, DefaultRuleIds, RetainRuleIds,
     CustomerActivityRuleIds, AssociationDecision
| extend IOCRelatedTools=RMMTools, MatchBasis=iff(DetectedToolId != "", "domain+identity", "domain")
| project DeviceNames, DeviceId, DetectedTool, DetectedToolId, SoftwareRole, IdentityBasis, IdentityIocNames, EvidenceLevel, ProfileVersion, ReportStatus, DispositionReason, ReviewCategory, InitiatingProcessFileName, ProductNames, IOCRelatedTools,
          MatchBasis, RemoteHost, MatchedDomains, SourcePatterns, RMMTools,
          FirstSeen, LastSeen, EventCount, InitiatingProcessFolderPath,
          InitiatingProcessSHA256, InitiatingProcessSHA1, Signers, SignedStates, TrustedStates,
          CertificateTimes, SignatureEvidenceSources, ExclusionSigners, ExclusionSignatureStates,
          SignatureEvidenceDeviceIds, SignatureEvidenceTimes, HashEvidenceConflicts,
          CommandLines, AccountNames, AccountDomains, ParentNames, ParentIds,
          OriginalFileNames, ProcessUniqueIds, ProcessCreationTimes, ProcessIds, RemoteURLs, RemoteIPs, RemotePorts, LocalIPs, CompanyNames

| union (print ReportStatus=iff(ProfileOK, "ok", "profile_data_unavailable"), ProfileVersion=ProfileRelease | where ReportStatus != "ok")
| extend ReportSection=iff(ReportStatus != "ok", "data_error", iff(EvidenceLevel == "supported_identity" and SoftwareRole == "rmm", "main", "review"))
| order by LastSeen desc
