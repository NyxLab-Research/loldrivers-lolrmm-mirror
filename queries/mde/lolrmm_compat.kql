// Identity data inline; generated by scripts/build_rmm_queries.py; rules 1.1.0; mode report; view all.
// Rule SHA256: e2129f816ef1d0609e8a5f8c0cb3ce9ff5f6afc23be9a5c3c4366d7736cab1d0; config SHA256: f75c4ff1f69b813a1e3170e2d0d903a16469c914750766db5e062f1ce5a26f2f.
// Event counts precede IOC association; collection fields are independent sets.
// Official references and usage: README.md. Validate Cortex with a 1h window.
let ReportStart = ago(7d);
let ReportEnd = now();
let CertificateStart = ago(30d);
let RMMRows = materialize(
    externaldata(Domain:string, RMMTool:string, Pattern:string, Regex:string)
    [h'https://raw.githubusercontent.com/NyxLab-Research/loldrivers-lolrmm-mirror/main/data/lolrmm_domains.csv']
    with (format="csv", ignoreFirstRecord=true)
    | extend Domain=tolower(trim_end(@"[.]+", Domain))
    | where isnotempty(Domain)
    | distinct Domain, RMMTool, Pattern
);
let SourceUnsafe = toscalar(RMMRows | summarize countif(not(Domain matches regex @"^[a-z0-9_-]+([.][a-z0-9_-]+)+$")) > 0);
let MissingTerms = toscalar(RMMRows | summarize countif(isempty(extract(@"[a-z0-9]{3,}", 0, Domain))) > 0);
let PrefilterTerms = toscalar(RMMRows | extend Term=extract(@"[a-z0-9]{3,}", 0, Domain) | summarize make_set(Term));
let TargetPattern = toscalar(RMMRows | extend Escaped=replace_string(Domain, ".", "[.]") | summarize Domains=make_set(Escaped) | project strcat("(?i)(?:^|://|//|[.@])(?:", strcat_array(Domains, "|"), ")[.]*(?::[0-9]+)?(?:[/?#]|$)"));
let ProfileRaw=materialize(datatable(profile_id:string,record_type:string,release:string,tool_id:string,tool_name:string,process_name:string,signers:string,software_role:string,ioc_names:string,expected_rows:string,release_digest:string)[
