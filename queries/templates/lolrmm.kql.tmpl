{{HEADER}}
let ReportStart = ago({{TIMEFRAME}});
let ReportEnd = now();
let CertificateStart = ago(30d);
let RMMRows = materialize(
{{MDE_SOURCE}}
    | extend Domain=tolower(trim_end(@"[.]+", Domain))
    | where isnotempty(Domain)
    | distinct Domain, RMMTool, Pattern
);
let SourceUnsafe = toscalar(RMMRows | summarize countif(not(Domain matches regex @"^[a-z0-9_-]+([.][a-z0-9_-]+)+$")) > 0);
let MissingTerms = toscalar(RMMRows | summarize countif(isempty(extract(@"[a-z0-9]{3,}", 0, Domain))) > 0);
let PrefilterTerms = toscalar(RMMRows | extend Term=extract(@"[a-z0-9]{3,}", 0, Domain) | summarize make_set(Term));
let TargetPattern = toscalar(RMMRows | extend Escaped=replace_string(Domain, ".", "[.]") | summarize Domains=make_set(Escaped) | project strcat("(?i)(?:^|://|//|[.@])(?:", strcat_array(Domains, "|"), ")[.]*(?::[0-9]+)?(?:[/?#]|$)"));
let Network = materialize(
    DeviceNetworkEvents
    | where Timestamp between (ReportStart .. ReportEnd)
    | where ActionType == "ConnectionSuccess" and isnotempty(RemoteUrl)
    | where SourceUnsafe or MissingTerms or array_length(PrefilterTerms) > 480
        or RemoteUrl has_any (array_slice(PrefilterTerms, 0, 119))
        or RemoteUrl has_any (array_slice(PrefilterTerms, 120, 239))
        or RemoteUrl has_any (array_slice(PrefilterTerms, 240, 359))
        or RemoteUrl has_any (array_slice(PrefilterTerms, 360, 479))
    | where SourceUnsafe or RemoteUrl matches regex TargetPattern
    | extend RemoteHost=tolower(trim_end(@"[.]+", tostring(parse_url(iff(RemoteUrl startswith "//", strcat("https:", RemoteUrl), iff(RemoteUrl contains "://", RemoteUrl, strcat("https://", RemoteUrl)))).Host)))
    | where isnotempty(RemoteHost)
    | project Timestamp, DeviceId, DeviceName, RemoteUrl, RemoteHost, RemoteIP,
              RemotePort, LocalIP, InitiatingProcessFileName, InitiatingProcessFolderPath,
              InitiatingProcessSHA1, InitiatingProcessSHA256, InitiatingProcessCommandLine,
              InitiatingProcessAccountName, InitiatingProcessAccountDomain,
              InitiatingProcessParentFileName, InitiatingProcessParentId,
              InitiatingProcessId, InitiatingProcessVersionInfoCompanyName,
              InitiatingProcessVersionInfoProductName
);
let FileKeys = Network | where isnotempty(InitiatingProcessSHA1) | distinct DeviceId, SHA1=InitiatingProcessSHA1;
let Certificates = FileKeys
    | join kind=inner hint.strategy=broadcast (
        DeviceFileCertificateInfo
        | where Timestamp between (CertificateStart .. ReportEnd)
        | project Timestamp, DeviceId, SHA1, IsSigned, IsTrusted, Signer
    ) on DeviceId, SHA1
    | summarize arg_max(Timestamp, IsSigned, IsTrusted, Signer) by DeviceId, SHA1
    | project DeviceId, InitiatingProcessSHA1=SHA1, CertificateObservedAt=Timestamp, IsSigned, IsTrusted, Signer;
let Activities = Network
    | join kind=leftouter Certificates on DeviceId, InitiatingProcessSHA1
    | extend RuleName=tolower(InitiatingProcessFileName),
             RulePath=iff(InitiatingProcessFolderPath matches regex @"^[A-Za-z]:[\\/]", tolower(replace_string(InitiatingProcessFolderPath, "/", "\\")), InitiatingProcessFolderPath),
             RuleSigner=tolower(Signer), RuleDeviceName=tolower(DeviceName),
             RuleSHA1=tolower(InitiatingProcessSHA1), RuleSHA256=tolower(InitiatingProcessSHA256),
             SignatureValid=iff(isnull(IsSigned) or isnull(IsTrusted), bool(null), IsSigned and IsTrusted)
{{ACTIVITY_DECISIONS}}
{{ACTIVITY_FILTER}}
    | summarize FirstSeen=min(Timestamp), LastSeen=max(Timestamp), EventCount=count(),
                DeviceNames=make_set(DeviceName), RemoteURLs=make_set(RemoteUrl),
                RemoteIPs=make_set(RemoteIP), RemotePorts=make_set(RemotePort), LocalIPs=make_set(LocalIP),
                AccountNames=make_set(InitiatingProcessAccountName), AccountDomains=make_set(InitiatingProcessAccountDomain),
                CompanyNames=make_set(InitiatingProcessVersionInfoCompanyName), ProductNames=make_set(InitiatingProcessVersionInfoProductName),
                CommandLines=make_set(InitiatingProcessCommandLine), ParentNames=make_set(InitiatingProcessParentFileName),
                ParentIds=make_set(InitiatingProcessParentId), ProcessIds=make_set(InitiatingProcessId),
                Signers=make_set(Signer), SignedStates=make_set(IsSigned), TrustedStates=make_set(IsTrusted),
                CertificateTimes=make_set(CertificateObservedAt)
      by DeviceId, RemoteHost, InitiatingProcessFileName, InitiatingProcessFolderPath,
         InitiatingProcessSHA1, InitiatingProcessSHA256, ActivityDecision, DefaultRuleIds, RetainRuleIds, CustomerActivityRuleIds
    | extend Labels=split(RemoteHost, ".")
    | mv-expand LabelIndex=range(0, array_length(Labels)-1, 1) to typeof(long)
    | extend Domain=strcat_array(array_slice(Labels, LabelIndex, -1), ".")
    | project-away Labels, LabelIndex;
RMMRows
| join kind=inner hint.strategy=broadcast Activities on Domain
{{ASSOCIATION_DECISIONS}}
{{ASSOCIATION_FILTER}}
| summarize MatchedDomains=make_set(Domain), RMMTools=make_set(RMMTool), SourcePatterns=make_set(Pattern),
            CustomerAssociationRuleIds=make_set(CustomerAssociationRuleIds),
            take_any(FirstSeen, LastSeen, EventCount, DeviceNames, RemoteURLs, RemoteIPs, RemotePorts, LocalIPs,
                     AccountNames, AccountDomains, CompanyNames, ProductNames, CommandLines, ParentNames,
                     ParentIds, ProcessIds, Signers, SignedStates, TrustedStates, CertificateTimes)
  by DeviceId, RemoteHost, InitiatingProcessFileName, InitiatingProcessFolderPath,
     InitiatingProcessSHA1, InitiatingProcessSHA256, ActivityDecision, DefaultRuleIds, RetainRuleIds,
     CustomerActivityRuleIds, AssociationDecision
| project DeviceNames, DeviceId, RMMTools, RemoteHost, MatchedDomains, SourcePatterns,
          FirstSeen, LastSeen, EventCount, InitiatingProcessFileName, InitiatingProcessFolderPath,
          InitiatingProcessSHA256, InitiatingProcessSHA1, Signers, SignedStates, TrustedStates,
          CertificateTimes, CommandLines, AccountNames, AccountDomains, ParentNames, ParentIds,
          ProcessIds, RemoteURLs, RemoteIPs, RemotePorts, LocalIPs, CompanyNames, ProductNames{{AUDIT_FIELDS}}
| order by LastSeen desc
