                and ((_signature_valid != null and (_signature_valid = true)))
                and ((_rule_signer != null and _rule_signer != "" and (_rule_signer ~= "^(?:beijing sogou technology development co[.]?,? ltd[.]?|tencent technology ?\(shenzhen\) company limited)$"))))
            or (((_rule_name != null and _rule_name != "" and (_rule_name = "google chrome")) or (_rule_name != null and _rule_name != "" and (_rule_name = "google chrome helper")) or (_rule_name != null and _rule_name != "" and (_rule_name = "google chrome helper (renderer)")) or (_rule_name != null and _rule_name != "" and (_rule_name = "google chrome helper (gpu)")) or (_rule_name != null and _rule_name != "" and (_rule_name = "google chrome helper (plugin)")))
