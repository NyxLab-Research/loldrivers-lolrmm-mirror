                and ((_rule_path != null and _rule_path != "" and (_rule_path ~= "^[a-z]:/program files(?: \(x86\))?/microsoft office/(?:root/)?office[0-9]+/outlook[.]exe$")))
                and ((_signature_valid != null and (_signature_valid = true)))
                and ((_rule_signer != null and _rule_signer != "" and (_rule_signer ~= "^microsoft corporation$")))
                and ((remote_host != null and remote_host != "" and (remote_host = "oth.eve.mdt.qq.com"))))), "rpt-outlook-mdt;", ""),
         if(((((_rule_name != null and _rule_name != "" and (_rule_name = "biz_helper.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sgbizlauncher.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "pinyinup.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sgtool.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sgsmartassistant.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sogouexe.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sogoucloud.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sogousmartassistant.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "biz_aurfx.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sgmyinput.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sgwangzai.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "usernetschedule.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "crashrpt.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "biz_tool.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sgpicfacetool.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "wubiup.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "imeutil.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "wbcrashrpt.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "isgpet.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sgiguidehelper.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "wbusernetschedule.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "write_spirit.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sgwizard.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sogou_voice_assistant.exe")) or (_rule_name != null and _rule_name != "" and (_rule_name = "sgfeedbackhelper.exe")))
                and ((_rule_path != null and _rule_path != "" and (_rule_path ~= "^[a-z]:/(?:[^/]+/)*(?:sogouinput|sogouwbinput)/")))
                and ((_signature_valid != null and (_signature_valid = true)))
                and ((_rule_signer != null and _rule_signer != "" and (_rule_signer ~= "(?:beijing sogou|tencent technology)")))
                and ((remote_host != null and remote_host != "" and (remote_host = "oth.eve.mdt.qq.com"))))), "rpt-sogou-input-mdt;", ""),
         if(((((_rule_name != null and _rule_name != "" and (_rule_name = "yuanbao.exe")))
                and ((_rule_path != null and _rule_path != "" and (_rule_path ~= "^[a-z]:/(?:program files(?: \(x86\))?/tencent/yuanbao|users/[^/]+/(?:appdata/(?:local|roaming)/(?:tencent/)?)?yuanbao)/yuanbao[.]exe$")))
                and ((_signature_valid != null and (_signature_valid = true)))
                and ((_rule_signer != null and _rule_signer != "" and (_rule_signer ~= "^tencent technology ?\(shenzhen\) company limited$")))
