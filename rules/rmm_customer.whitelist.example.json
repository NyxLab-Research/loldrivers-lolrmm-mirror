{
  "schema_version": 1,
  "customer_id": "customer-example",
  "disabled_default_rules": [],
  "retain_rules": [],
  "whitelist": [
    {
      "id": "approved-support-connection",
      "enabled": true,
      "reason": "Customer-approved connection on the specified device",
      "target": "activity",
      "expires_at": "2099-01-01T00:00:00Z",
      "conditions": [
        {
          "field": "process_name",
          "operator": "equals",
          "value": "example-support.exe"
        },
        {
          "field": "remote_host",
          "operator": "exact",
          "value": "support.example.invalid"
        },
        {
          "field": "device_id",
          "operator": "in",
          "values": [
            "device-example-01"
          ]
        }
      ]
    }
  ]
}
